# Copy to `.streamlit/secrets.toml` (local) or paste into the Community Cloud
# app's Secrets editor. Never commit the real file.

# This bundle defaults to PUBLIC mode, so DASHBOARD_PUBLIC_MODE is optional here
# (a missing or mistyped value still yields public mode). To run the internal
# build from this bundle, set the explicit opt-in instead:
# DASHBOARD_INTERNAL_MODE = "1"

# Private Hugging Face Dataset holding the DuckDB export.
HF_DATASET_REPO = "your-hf-user/iran-macro-dashboard-data"
HF_DATASET_FILENAME = "dashboard.duckdb"
# Read-only token with access to that one dataset.
HF_TOKEN = "hf_..."
